# Copy this file to .env and fill in only the values for the provider you use.
#
# Do not put real values in this file. It is distributed with the project.
# Real values belong in .env, which is gitignored and excluded from any archive.

# --- Market ---
# us (default) or uk. Sets currency, date format, spelling, the regulation a
# persona names, and the emergency number - 911 or 999.
# FRONTDESK_REGION=us

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local, no credentials) ---
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# FRONTDESK_OLLAMA_KEEP_ALIVE=30m
# FRONTDESK_OLLAMA_NUM_CTX=8192
# FRONTDESK_OLLAMA_NUM_BATCH=256
# FRONTDESK_CHAT_MAX_TOKENS=256
# FRONTDESK_CHANNEL_MAX_TOKENS=256

# --- Frontdesk authentication (required by default) ---
# A random value of at least 32 characters. It signs access tokens.
# FRONTDESK_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# A token from: python auth.py --subject operator@example.com --roles operator
# FRONTDESK_ACCESS_TOKEN=...
# Turns authentication off for the local echo demo. Never in production.
# FRONTDESK_AUTH_MODE=disabled

# --- Live order/reservation backend (optional) ---
# Unset, the demo data in data/store.json is used. Production requires HTTPS.
# FRONTDESK_BACKEND_URL=https://api.example.com/frontdesk/v1
# FRONTDESK_BACKEND_TOKEN=...
# FRONTDESK_BACKEND_TIMEOUT=10

# --- Social channels (optional) ---
# GitHub Issues and Discussions
# FRONTDESK_GITHUB_WEBHOOK_SECRET=... # unique random secret for POST /github
# FRONTDESK_GITHUB_TOKEN=...          # current App installation or fine-grained token
# FRONTDESK_GITHUB_BOT_LOGIN=frontdesk-support[bot]
# FRONTDESK_GITHUB_PERSONA=github-support
# FRONTDESK_GITHUB_PROVIDER=ollama
# GitHub Actions uses its short-lived GITHUB_TOKEN instead of the token above.
# Direct webhook deployments must refresh expiring App installation tokens externally.
#
# Slack, for an internal help desk
# FRONTDESK_SLACK_SIGNING_SECRET=...
# FRONTDESK_SLACK_BOT_TOKEN=xoxb-...
# FRONTDESK_SLACK_TEAM_ID=T01234567
# FRONTDESK_CHANNEL_SLACK_ROLES=support     # support and operator at most
#
# Microsoft Teams, as an outgoing webhook (no Azure registration needed)
# FRONTDESK_TEAMS_SECURITY_TOKEN=...     # shown once when the webhook is created
# FRONTDESK_TEAMS_TENANT_ID=...          # optional; rejects other tenants
#
# Meta, for Instagram DMs and Messenger
# FRONTDESK_META_APP_SECRET=...
# FRONTDESK_META_PAGE_TOKEN=...
# FRONTDESK_META_VERIFY_TOKEN=...
# FRONTDESK_META_GRAPH_VERSION=v26.0
# WhatsApp Cloud API
# FRONTDESK_WHATSAPP_APP_SECRET=...
# FRONTDESK_WHATSAPP_TOKEN=...
# FRONTDESK_WHATSAPP_VERIFY_TOKEN=...
# Signed inbound email relay and tenant SMTP profiles
# FRONTDESK_EMAIL_WEBHOOK_SECRET=... # at least 32 random characters
# FRONTDESK_INTEGRATIONS_FILE=C:\secure\frontdesk-integrations.json
# Or poll a purchaser-owned shared mailbox directly with email_mailbox.py.
# FRONTDESK_EMAIL_IMAP_HOST=imap.example.com
# FRONTDESK_EMAIL_IMAP_PORT=993
# FRONTDESK_EMAIL_SMTP_HOST=smtp.example.com
# FRONTDESK_EMAIL_SMTP_PORT=587
# FRONTDESK_EMAIL_USER=support@example.com
# FRONTDESK_EMAIL_PASSWORD=...       # set only in the runtime secret manager
# FRONTDESK_EMAIL_ADDRESS=support@example.com
# FRONTDESK_EMAIL_FOLDER=INBOX
# FRONTDESK_EMAIL_TENANT_ID=customer-a
# FRONTDESK_EMAIL_PERSONA=ecommerce
# FRONTDESK_PUBLIC_URL=https://support.example.com
# FRONTDESK_FEEDBACK_SECRET=...      # 32+ random characters
# Public channels are fixed at guest. No setting can loosen that.

# --- Embedded web widget ---
# FRONTDESK_PUBLIC_ORIGIN=https://support.example.com
# FRONTDESK_WEB_PERSONA=ecommerce
# Space-separated CSP sources, each an exact trusted origin.
# FRONTDESK_EMBED_ORIGINS=https://www.example.com https://shop.example.com

# --- Approving from a phone (optional) ---
# Without this, an irreversible action arriving on a channel is declined,
# because there is no terminal to confirm at. With it, it waits for a tap.
# FRONTDESK_REMOTE_APPROVAL=1

# --- LinkedIn sign-in (optional) ---
# Not a message channel: LinkedIn gives no inbound DM webhook to third parties.
# This is how somebody on a public channel proves who they are, so that they can
# reach their own records instead of being stuck at guest.
# FRONTDESK_LINKEDIN_CLIENT_ID=...
# FRONTDESK_LINKEDIN_CLIENT_SECRET=...
# Must match the redirect URL registered with the LinkedIn app, exactly.
# FRONTDESK_LINKEDIN_REDIRECT_URI=https://verify.example.com/linkedin/callback
# Signs the sign-in links. 32+ characters, separate from every other secret.
# FRONTDESK_LINKEDIN_STATE_SECRET=...
# Email domains that count as our own staff. Optional.
# FRONTDESK_LINKEDIN_WORKSPACE_DOMAINS=example.com
# How long a completed verification lasts. Default 8 hours.
# FRONTDESK_IDENTITY_TTL_HOURS=8
