# Copy this file to .env and replace both secrets before starting FrontDesk.
# Generate each value independently with: python auth.py --new-secret
FRONTDESK_AUTH_SECRET=
FRONTDESK_FEEDBACK_SECRET=

FRONTDESK_REGION=us
FRONTDESK_INDUSTRY=salon
FRONTDESK_WEB_PERSONA=salon
FRONTDESK_WEB_TENANT_ID=salon:default

# Local-only is the safe default. Use 0.0.0.0 only behind a trusted HTTPS proxy.
FRONTDESK_BIND_ADDRESS=127.0.0.1
FRONTDESK_ADMIN_BIND_ADDRESS=127.0.0.1
FRONTDESK_WEB_PORT=8766
FRONTDESK_ADMIN_PORT=8765
FRONTDESK_SECURE_COOKIES=0

# Space-separated HTTPS origins allowed to embed the customer widget.
FRONTDESK_EMBED_ORIGINS='self'
OLLAMA_MODEL=qwen3:8b
